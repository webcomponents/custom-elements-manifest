{
  "include": ["schema.d.ts", "src/**/*.ts"],
  "exclude": [],
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "./src/",
    "outDir": "./",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "lib": [
      "DOM.iterable",
      "DOM",
      "ES5",
      "ES6",
      "ES2020",
      "ES2022",
      "ES2024",
      "ES2015.Generator",
      "ESNext.Collection",
      "ESNext.Array",
      "ESNext.Iterator",
      "ESNext.AsyncIterable",
      "ESNext.Disposable",
      "ScriptHost"
    ],
  },
}
